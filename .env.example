# Copia este archivo como .env para personalizar la configuración (opcional).
# Clave para firmar la sesión. En producción usa un valor largo y aleatorio.
FISIOGEST_SECRET_KEY=cambia-esta-clave-en-produccion
# Ruta del archivo SQLite (por defecto: instance/fisiogest.db)
FISIOGEST_DATABASE=instance/fisiogest.db
# 1 = carga usuarios y datos de demostración la primera vez que se ejecuta
FISIOGEST_DEMO=1
# Puerto del servidor de desarrollo
FISIOGEST_PORT=5000
